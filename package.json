{
  "name": "@theinterfaces-lab/loop",
  "version": "0.4.0",
  "description": "Loop is the wire \u2014 connect inputs, outputs, controls and devices with one normalized packet.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./controls": {
      "types": "./dist/kit/index.d.ts",
      "import": "./dist/kit/index.js"
    },
    "./devices": {
      "types": "./dist/devices/index.d.ts",
      "import": "./dist/devices/index.js"
    },
    "./recipes": {
      "types": "./dist/recipes.d.ts",
      "import": "./dist/recipes.js"
    }
  },
  "files": [
    "dist",
    "SPEC.md"
  ],
  "scripts": {
    "build": "node_modules/.bin/tsc",
    "test": "node_modules/.bin/vitest run",
    "validate": "node_modules/.bin/tsc --noEmit && node_modules/.bin/vitest run",
    "relay": "node scripts/relay-server.mjs"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "jsdom": "^30.0.1",
    "typescript": "^5",
    "vitest": "^3",
    "ws": "^8.21.3"
  }
}